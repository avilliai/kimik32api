# ==========================================
# 注册邮箱与认证配置 (支持两套邮箱系统)
# ==========================================

# 注册邮箱类型: auto / outlook / domain
# auto:    优先使用 Outlook 账号文件，若未配置或失败则降级到 Cloudflare Worker 域名邮箱
# outlook: 仅使用本地 Outlook 账号文件轮询注册
# domain:  仅使用 Cloudflare Worker 域名临时邮箱
REGISTER_EMAIL_TYPE=auto

# ------------------------------------------
# 方式一：Outlook 文件账号池配置
# ------------------------------------------
# Outlook 账号文本文件路径（格式：邮箱----密码----client_id----refresh_token）
# 默认留空时自动搜索项目根目录下的 outlook_live_*.txt 文件
OUTLOOK_FILE=outlook_live_20261018_222014.txt
OUTLOOK_TOKEN_URL=https://login.microsoftonline.com/common/oauth2/v2.0/token
OUTLOOK_IMAP_HOSTS=outlook.office365.com;imap-mail.outlook.com
OUTLOOK_IMAP_PORT=993

# ------------------------------------------
# 方式二：Cloudflare Worker 域名临时邮箱配置
# ------------------------------------------
WORKER_DOMAIN=your_worker.workers.dev
EMAIL_DOMAIN=your_domain.com
ADMIN_PASSWORD=your_admin_password

# ==========================================
# 代理与号池配置
# ==========================================
# 代理地址（本地 clash / v2ray 端口）
PROXY=http://127.0.0.1:10809
# 激活保活号池账号数量
ACTIVE_POOL_SIZE=3
# API 访问密钥（可选，为空则不鉴权）
PROXY_API_KEY=

# ==========================================
# 验证码 (Turnstile) 配置
# ==========================================
# 若留空且遇到 Turnstile，会自动尝试请求本地求解器 (http://127.0.0.1:5072)
YESCAPTCHA_KEY=
LOCAL_TURNSTILE_URL=http://127.0.0.1:5072
